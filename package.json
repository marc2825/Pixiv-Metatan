{
  "name": "pixiv-ai-metadata-inspector",
  "private": true,
  "version": "0.1.0",
  "description": "User-initiated AI image metadata inspection on pixiv artworks",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "engines": {"node": ">=22"}
}
