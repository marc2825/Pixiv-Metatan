{
  "name": "pixiv-ai-metadata-inspector",
  "private": true,
  "version": "0.1.0",
  "description": "Hover previews and user-initiated AI image metadata inspection on pixiv (Chrome/Edge MV3)",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "pretest": "wxt prepare",
    "test": "vitest run",
    "test:browser": "vite build --config tests/browser/vite.config.ts && playwright test",
    "test:extension": "npm run build && playwright test --config playwright.extension.config.ts",
    "verify:live": "node --experimental-strip-types scripts/verify-live.ts",
    "test:watch": "vitest",
    "check:manifest": "node scripts/check-manifest.mjs",
    "zip:edge": "wxt zip -b edge",
    "fixtures:reference": "python3 scripts/reference-fixtures.py"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT"
}
