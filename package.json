{
  "name": "pixiv-ai-metadata-inspector",
  "private": true,
  "version": "0.1.0",
  "description": "User-initiated AI image metadata inspection on pixiv artworks",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "pretest": "wxt prepare",
    "test": "vitest run",
    "test:browser": "vite build --config tests/browser/vite.config.ts && playwright test",
    "test:extension": "npm run build && playwright test --config playwright.extension.config.ts",
    "verify:live": "node --experimental-strip-types scripts/verify-live.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "jsdom": "29.1.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
